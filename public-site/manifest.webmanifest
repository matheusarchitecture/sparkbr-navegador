{
  "name": "SparkBR — Navegador da Família",
  "short_name": "SparkBR",
  "description": "Inteligência brasileira para a vida real. IA integrada e 23 aplicativos gratuitos para a família.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f6f7f2",
  "theme_color": "#173f35",
  "categories": [
    "lifestyle",
    "shopping",
    "health",
    "finance"
  ],
  "icons": [
    {
      "src": "/assets/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Spark Mercado",
      "url": "/spark/"
    },
    {
      "name": "Spark Saúde",
      "url": "/saude/"
    },
    {
      "name": "Contas da Casa",
      "url": "/contas/"
    },
    {
      "name": "Cardápio da Semana",
      "url": "/cardapio/"
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+spark",
      "url": "/?cmd=%s"
    }
  ]
}