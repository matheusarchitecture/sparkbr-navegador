# SparkBR Navegador 2.1 — exemplo, não coloque esta chave em HTML/PWA/Electron.
PORT=3080
OPENAI_API_KEY=
SPARK_AI_MODEL=gpt-4.1-mini
# O token da conta é validado pelo endpoint existente do SparkBR. Configure no servidor.
SPARK_AUTH_ME_URL=https://sparkbr.online/spark-api/perfil
SPARK_LOGOUT_URL=https://sparkbr.online/spark-api/auth/sair
# Armazene registros fora da raiz pública; em VPS, use um diretório persistente com permissão para o serviço.
SPARK_DATA_DIR=./data
