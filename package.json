{
  "name": "sparkbr-navegador",
  "productName": "SparkBR Navegador",
  "version": "2.2.5",
  "private": true,
  "description": "Navegador SparkBR com 23 aplicativos, conta principal existente e compartilhamento familiar.",
  "author": "SparkBR (Matheus Barcellos)",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "desktop": "electron .",
    "build:win": "electron-builder --win nsis",
    "build:linux": "electron-builder --linux AppImage",
    "build:mac": "electron-builder --mac dmg",
    "test": "node --test tests/*.test.mjs",
    "integrate:apps": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/integrate-apps.ps1"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "online.sparkbr.navegador",
    "productName": "SparkBR Navegador",
    "asar": true,
    "files": [
      "desktop/**/*",
      "site/**/*",
      "public-site/**/*",
      "backend-patch/**/*",
      "docs/**/*",
      "server.mjs",
      "ecosystem.mjs",
      "package.json",
      "LICENSE",
      "LICENSE-NSIS.txt"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "site/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SparkBR Navegador",
      "license": "LICENSE-NSIS.txt"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}